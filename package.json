{
  "name": "@sharewiner/dsh-model-management",
  "version": "0.2.3",
  "type": "module",
  "description": "DSH model management, synchronized model visibility, and OpenAI Responses web search.",
  "license": "MIT",
  "author": "sharewiner",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharewiner/dsh-model-management.git"
  },
  "bugs": {
    "url": "https://github.com/sharewiner/dsh-model-management/issues"
  },
  "homepage": "https://github.com/sharewiner/dsh-model-management#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "model-management",
    "openai",
    "web-search"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./model-directory-compat": "./lib/model-directory-compat.js",
    "./model-visibility": "./lib/model-visibility.js",
    "./openai-responses-search": "./lib/openai-responses-search.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/model-directory-compat.js && node --check lib/model-visibility.js && node --check lib/openai-responses-search.js",
    "release:check": "node --test test/release-contract.test.js && npm run check && npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": ["lib/*.js", "cordis.patch.yml", "README.md", "README.zh-CN.md", "CHANGELOG.md", "LICENSE"],
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-web": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.0.0"
  }
}
